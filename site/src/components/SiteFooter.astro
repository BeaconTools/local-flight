---
import { currentRelease, githubUrl, navItems, releaseUrl } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-grid terminal-frame">
    <div class="footer-identity">
      <img class="beacon-lockup beacon-lockup--dark" src="/assets/beacon-tools-lockup-dark.svg" alt="Beacon Tools" width="380" height="64" />
      <img class="beacon-lockup beacon-lockup--light" src="/assets/beacon-tools-lockup-light.svg" alt="Beacon Tools" width="380" height="64" />
      <p class="footer-studio">Complex data, made useful.</p>
      <p>Free, open-source Local Flight software. Optional paid Beacon Relay access. No advertising or behavioral tracking.</p>
    </div>
    <div class="footer-column">
      <h2>Destinations</h2>
      {navItems.slice(0, 3).map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="footer-column">
      <h2>Help &amp; policy</h2>
      {navItems.slice(3).map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/privacy/choices/">Privacy choices</a>
      <a href="/status/">Service status</a>
      <a href="/local-flight/relay-access/terms/">Relay Access terms</a>
      <a href="/legal/">Legal and operator</a>
    </div>
    <div class="footer-column">
      <h2>Project</h2>
      <a href={githubUrl}>Source on GitHub</a>
      <a href={releaseUrl}>Release {currentRelease}</a>
      <a href={`${githubUrl}/blob/main/THIRD_PARTY_NOTICES.md`}>Third-party notices</a>
    </div>
  </div>
  <div class="footer-base terminal-frame">
    <span>© Beacon Tools</span>
    <span>Local-first · accountless in normal use · online features optional</span>
  </div>
</footer>
