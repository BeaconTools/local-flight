---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import MediaStage from "../components/MediaStage.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import Icon from "../components/Icon.astro";
import BeaconHero from "../components/BeaconHero.astro";
import { availability, brand, makerNote } from "../data/site";
import fidsImage from "../assets/screens/shell/fids-browser-dark.png";
const relayLive = availability.relayAccess === "live";
---

<SiteLayout title="Beacon Tools" description={brand.studioDescription} active="home" bodyClass="studio-home">
  <header class="terminal-hero studio-hero">
    <div class="terminal-frame studio-hero-grid">
      <div class="studio-hero-copy">
      <div class="eyebrow">Independent software studio</div>
      <h1 class="hero-title">Complex data,<br /><span class="accent-word">made useful.</span></h1>
      <p class="hero-lede">{brand.studioDescription}</p>
      <div class="hero-actions">
        <a class="action-button action-button--primary" href="/local-flight/">Explore Local Flight <span aria-hidden="true">→</span></a>
        <a class="action-link" href="#products">See what we make</a>
      </div>
      <p class="studio-maker">{brand.attribution}</p>
      </div>
      <BeaconHero />
    </div>
  </header>

  <section class="section section--raised section--ruled" id="products">
    <div class="terminal-frame">
      <div class="terminal-grid split-story" id="outputs">
        <div class="split-story-copy">
          <span class="section-index">01 / FEATURED PRODUCT</span>
          <h2>Local Flight.<br />Your flight board. Your way.</h2>
          <p>Local Flight is free, open-source software for aviation enthusiasts. Bring schedules, nearby aircraft, weather, and movement history together on your own hardware.</p>
          <p>Connect supported providers with your own API keys, follow VATSIM virtual traffic, or choose optional Beacon Relay access.</p>
          <div class="inline-actions"><a class="action-button action-button--primary" href="/local-flight/#downloads">Download Local Flight</a><a class="action-link" href="/local-flight/#flight-data">Choose your data</a></div>
        </div>
        <div class="split-story-media">
          <MediaStage src={fidsImage} alt="Local Flight browser departures board showing demonstration flights" label="LOCAL FLIGHT / DEPARTURES" meta="Browser interface · demonstration data" loading="eager" />
        </div>
      </div>
      <SectionHeading index="THE LOCAL FLIGHT FAMILY" title="One application. More ways to enjoy it." description="Local Flight is the application. Mobile puts it in your pocket. Relay Access is the only paid part, and only if you want hosted flight data." />
      <ProductGrid />
    </div>
  </section>
  <section class="section section--quiet section--ruled">
    <div class="terminal-frame">
      <SectionHeading index="02 / SOFTWARE PRINCIPLES" title="Local first is a practical boundary." description="Local Flight keeps its everyday state near the person running it. Online connections have a clear purpose and stay optional where the product allows." />
      <div class="feature-grid feature-grid--four" data-reveal>
        <article class="feature-tile">
          <span class="icon-badge icon-badge--sm"><Icon name="monitor" /></span>
          <h3>Runs on your hardware</h3>
          <p>Settings, saved boards, movement history, logs, and your own provider keys normally stay on your computer or phone.</p>
        </article>
        <article class="feature-tile">
          <span class="icon-badge icon-badge--sm"><Icon name="eyeOff" /></span>
          <h3>No required Beacon profile</h3>
          <p>Normal use has no Beacon Tools account. There is no advertising, behavioral analytics, cross-site tracking, or sale of usage data.</p>
        </article>
        <article class="feature-tile">
          <span class="icon-badge icon-badge--sm"><Icon name="network" /></span>
          <h3>Online features are named</h3>
          <p>Beacon Relay, Remote Companion, reports, and diagnostics connect only for the function you choose. Automatic diagnostics require consent.</p>
        </article>
        <article class="feature-tile">
          <span class="icon-badge icon-badge--sm"><Icon name="code" /></span>
          <h3>The source can be inspected</h3>
          <p>The desktop and server application remain open source, including the local data paths and display logic you run.</p>
        </article>
      </div>
      <div class="inline-actions editorial-actions">
        <a class="action-button" href="/privacy/">Read the privacy design</a>
        <a class="action-link" href="/privacy/choices/">Change privacy choices</a>
      </div>
    </div>
  </section>


  <section class="section section--compact" id="studio">
    <div class="terminal-frame terminal-grid editorial-pair">
      <div class="editorial-heading"><span class="section-index">03 / THE STUDIO</span><h2>Made with a purpose.</h2></div>
      <div class="editorial-copy">
        <p class="studio-intro">We build software that connects the information you care about with the way you want to use it. Our first product brings the airport to your own screens.</p>
        <p>Beacon Tools makes complex data useful through focused software, considered interfaces, and clear choices about how things connect.</p>
        <p class="maker-attribution">{brand.attribution}</p>
        <details class="maker-story"><summary>How Local Flight started</summary><p>{makerNote}</p></details>
        <a class="action-link" href="https://github.com/BeaconTools/local-flight">Inspect the source on GitHub</a>
      </div>
    </div>
  </section>
  <section class="section" id="why-relay-is-paid">
    <div class="terminal-frame terminal-grid editorial-pair">
      <div class="editorial-heading" data-reveal>
        <span class="section-index">04 / THE ONE PAID PART</span>
        <h2>Why Beacon Relay is paid.</h2>
      </div>
      <div class="editorial-copy" data-reveal>
        <p>The application stays free and open source. Beacon Relay is a hosted service with real running costs, and charging for it directly is what keeps the project going without advertising, tracking, or putting the software behind an account.</p>
        {relayLive
          ? <p class="prelaunch-inline" data-release-state="live"><strong>Price:</strong> Relay Access is CHF 8 per year and renews automatically. Companion, Bring Your Own Keys, and VATSIM stay free.</p>
          : <p class="prelaunch-inline"><strong>Prelaunch:</strong> Relay Access purchases are being prepared. No payment can be started yet.</p>}
          <a class="action-link" href="/local-flight/relay-access/#get-access">See what Relay Access includes</a>
      </div>
    </div>
  </section>


  <section class="section section--compact">
    <div class="terminal-frame"><div class="cta-band">
      <h2>Your next view of the airport.</h2>
      <p>Download the free application, choose a data source, and make the display your own.</p>
      <div class="inline-actions"><a class="action-button action-button--primary" href="/local-flight/#downloads">Download Local Flight</a><a class="action-link" href="/support/">Talk to Beacon Tools</a></div>
    </div></div>
  </section>
  <SafetyNotice />
</SiteLayout>
